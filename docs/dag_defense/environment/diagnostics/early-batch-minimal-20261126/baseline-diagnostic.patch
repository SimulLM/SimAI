@@ -14,6 +14,25 @@ from vidur.entities.replica import ReplicaType
 
 logger = init_logger(__name__)
 
+class DecodeReadyEnqueueEvent(BaseEvent):
+    """Diagnostic baseline: deliver a request at its modeled transfer finish."""
+    def __init__(self, time, replica_id, request):
+        super().__init__(time, EventType.REPLICA_SCHEDULE)
+        self.replica_id, self.request = replica_id, request
+
+    def handle_event(self, scheduler, metrics_store):
+        from vidur.events.replica_schedule_event import ReplicaScheduleEvent
+        if self.time < self.request.decode_arrived_at:
+            raise RuntimeError("premature decode enqueue")
+        rs = scheduler.get_replica_scheduler(self.replica_id)
+        if self.request in rs._request_queue:
+            raise RuntimeError("duplicate decode enqueue")
+        rs._request_queue.append(self.request)
+        return [ReplicaScheduleEvent(self.time, self.replica_id)]
+
+    def to_dict(self):
+        return {"time": self.time, "event_type": "decode_ready_enqueue", "request_id": self.request.id, "replica_id": self.replica_id}
+
 
 # 一个micro-batch在pipeline上执行结束
